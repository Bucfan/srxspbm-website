# Copy this file to .env.deploy and fill in the values. .env.deploy is ignored by git.
# Credentials come from cPanel > FTP Accounts on the GoDaddy hosting account.

SRXS_FTP_HOST=ftp.simplifiedrxsolutions.com
SRXS_FTP_USER=
SRXS_FTP_PASS=

# Optional. Defaults shown.
# SRXS_FTP_PORT=21
# SRXS_FTP_TLS=1            # 0 for plain FTP if the host has no FTPS
# SRXS_FTP_TLS_VERIFY=1     # 0 to accept the server certificate without checking its name
# SRXS_FTP_CA_FILE=         # extra CA bundle for certificate verification
# SRXS_FTP_REMOTE_DIR=      # site root on the server; auto-detected when empty
# SRXS_SITE_URL=https://www.simplifiedrxsolutions.com
